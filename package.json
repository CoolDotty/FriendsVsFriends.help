{
  "name": "fvf-decks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "pnpm dev",
    "build": "vite build",
    "build-fvfhelp": "vite build",
    "build-itch": "vite build --mode itch && bestzip fvf-decks-itch.zip dist/*",
    "preview": "vite preview",
    "debugProd": "pnpm build && pnpm preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "deploy": "pnpm build-fvfhelp && gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.4",
    "bestzip": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.3.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
